{
  "name": "backend",
  "version": "1.0.0",
  "description": "Sociva backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "worker": "node workers/worker.js",
    "dev:worker": "node --watch workers/worker.js",
    "prewarm": "node scripts/prewarmNow.js",
    "test": "npm run test:research && npm run test:brief && npm run test:publish && npm run test:agent && npm run test:hashtags && npm run test:speed && npm run test:competitors && npm run test:facebook && npm run test:imagegen && npm run test:media && npm run test:intel",
    "test:competitors": "node --test tests/competitorResearch/competitorResearch.test.js",
    "test:hashtags": "node --test tests/hashtags/hashtags.test.js",
    "test:agent": "node --test --test-concurrency=1 tests/productAgent/productAgent.test.js",
    "eval:agent": "node tests/productAgent/run.js",
    "test:research": "node --test tests/marketResearch/marketResearch.test.js",
    "test:brief": "node --test tests/contentBrief/contentBrief.test.js tests/contentBrief/captionFormat.test.js",
    "test:publish": "node --test tests/instagramPublish/story.test.js",
    "test:facebook": "node --test tests/facebook/facebook.test.js",
    "test:imagegen": "node --test tests/imageGen/imageGen.test.js tests/imageGen/brandKit.test.js",
    "test:media": "node --test tests/media/cloudStorage.test.js",
    "test:intel": "node --test tests/competitorIntelligence/competitorIntelligence.test.js",
    "test:speed": "node --test tests/hashtags/researchSpeed.test.js",
    "test:queue": "node --test --test-concurrency=1 tests/hashtags/researchQueue.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.25.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.14",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4"
  }
}
